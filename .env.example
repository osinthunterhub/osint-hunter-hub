# ================= OSINT Hunter Hub — .env.example (v2.0) =================
# NAYA RULE: koi bhi secret code me hardcode NAHI hai. Sab yahan se aata hai.
# Render par: Dashboard -> Environment -> add env vars.

# 1) BOT TOKEN (BotFather se) — zaroori
BOT_TOKEN=PUT_YOUR_BOT_TOKEN_HERE

# 2) Owner / Admin
ADMIN_ID=YOUR_NUMERIC_ADMIN_ID
OWNER_USERNAME=@ANONYMOUS_XH
BRAND_TAG=@ANONYMOUS_XH

# 3) Force Join channel
FORCE_CHANNEL=-1004393596502
FORCE_CHANNEL_LINK=https://t.me/osint_xpert
FORCE_CHANNEL_USERNAME=osint_xpert

# 4) API hub (utility-api-vu83)
MYNUM_API_URL=https://utility-api-vu83.onrender.com/api
MYNUM_API_KEY=PUT_YOUR_HUB_KEY_HERE
FAMINFO_API_URL=https://utility-api-vu83.onrender.com/api
FAMINFO_API_KEY=PUT_YOUR_HUB_KEY_HERE
UPIINFO_API_URL=https://utility-api-vu83.onrender.com/api
UPIINFO_API_KEY=PUT_YOUR_HUB_KEY_HERE

# 5) Telegram scraper (my.telegram.org) — optional
API_ID=
API_HASH=
SESSION_STRING=

# 6) Payments
UPI_ID=kumaranil98787@axl
UPI_NAME=OSINT Hunter Hub
FREE_CREDITS=10
TG_CREDITS=3
# v2.7: 1 = sab tools FREE (premium off) | 0 = premium/paywall ON
FREE_FOR_ALL=1

# 7) Self URL + webhook (pinger ke liye ZAROORI)
BOT_SELF_URL=https://osint-hunter-hub-bot.onrender.com
WEBHOOK_URL=https://osint-hunter-hub-bot.onrender.com/webhook

# 8) VAULT (data kabhi na khoye — users/premium/payments)
VAULT_GITHUB_TOKEN=PUT_GITHUB_PAT_HERE
VAULT_REPO=savecontentrestricted-pixel/osint
VAULT_BRANCH=vault-backup
VAULT_KEY=PUT_RANDOM_64_CHAR_KEY_HERE
VAULT_BACKUP_MINUTES=10

# 9) Safety limits (auto-restart)
MEM_RESTART_MB=470
HANG_RESTART_SECONDS=900
